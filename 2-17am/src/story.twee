:: StoryStylesheet [stylesheet]
/*
   A restrained bureaucratic/noir treatment: paper, steel and one warning
   colour.  All typefaces are local system fallbacks so the exported file
   remains self-contained.
*/
:root {
  --ink: #d8d5cc;
  --muted: #8b9298;
  --steel: #11161a;
  --steel-light: #202a30;
  --line: #354149;
  --paper: #090b0d;
  --warning: #a94442;
  --voss: #91b0bd;
  --alex: #d6ad79;
}

html, body {
  background: var(--paper);
  color: var(--ink);
}

body {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.08rem;
  line-height: 1.48;
}

#ui-bar {
  box-sizing: border-box;
  width: 100%;
  height: auto;
  min-height: 3.4rem;
  padding: .7rem max(1rem, calc((100vw - 700px) / 2));
  border: 0;
  border-bottom: 1px solid var(--line);
  background: #0d1114;
  color: var(--muted);
  position: relative;
  left: auto !important;
  top: auto;
}

#ui-bar.stowed {
  left: auto !important;
}

#ui-bar-toggle,
#ui-bar-tray,
#story-title,
#story-author,
#menu {
  display: none !important;
}

#ui-bar-body,
#story-caption {
  height: auto;
  margin: 0;
  padding: 0;
  overflow: visible;
  display: block;
}

#story-caption {
  margin: 0;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: .72rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.case-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.sound-toggle {
  padding: .28rem .48rem;
  border: 1px solid #52616a;
  background: #12191d;
  color: var(--muted);
  font: inherit;
  font-size: .9em;
  letter-spacing: .08em;
  text-transform: uppercase;
  cursor: pointer;
}

.sound-toggle:hover,
.sound-toggle:focus-visible {
  border-color: var(--ink);
  color: var(--ink);
  outline: 2px solid transparent;
}

.case-clock {
  color: var(--ink);
  letter-spacing: .2em;
}

.suspicion-label {
  color: var(--muted);
  white-space: nowrap;
}

.suspicion-meter {
  display: inline-flex;
  gap: .22rem;
  margin-left: .45rem;
  vertical-align: middle;
}

.suspicion-block {
  width: .62rem;
  height: .62rem;
  border: 1px solid #56616a;
  background: transparent;
  display: inline-block;
}

.suspicion-block.is-active {
  border-color: var(--warning);
  background: var(--warning);
  box-shadow: 0 0 5px rgba(169, 68, 66, .32);
}

#story {
  box-sizing: border-box;
  width: min(700px, calc(100% - 2rem));
  margin: 1.5rem auto 2.5rem;
  padding: 1.35rem clamp(1.2rem, 5vw, 3.2rem) 1.7rem;
  border: 1px solid var(--line);
  background: var(--steel);
  box-shadow: 0 1.4rem 4rem rgba(0, 0, 0, .28);
  transition: border-color 280ms ease, box-shadow 280ms ease, background 280ms ease;
}

body.suspicion-elevated #story {
  border-color: #614145;
  box-shadow: 0 1.4rem 4rem rgba(76, 22, 23, .2);
}

body.suspicion-critical #story {
  border-color: #854346;
  background: #181518;
  box-shadow: 0 1.4rem 4rem rgba(111, 29, 30, .32);
}

body.flashback-mode #story {
  border-color: #526773;
  background: #121a20;
}

body.ending-mode #story {
  border-color: #6e655c;
  background: #151618;
}

.passage {
  animation: passage-in 250ms ease-out both;
}

/* SugarCube renders source line breaks as literal <br> elements.  StoryScript
   converts blank-line stacks into these controlled beats. */
#passages .passage > br {
  display: none;
}

.passage .story-beat {
  display: block;
  height: .38rem;
}

.passage .story-beat:has(+ .dialogue-line) {
  height: .18rem;
}

/* SugarCube renders choice markup as a list; the cards should read like a
   clean stack of forms rather than a browser default list. */
#passages ul {
  list-style: none;
  margin: .8rem 0 0;
  padding: 0;
}

#passages li {
  margin: 0;
  padding: 0;
}

.passage > p {
  margin: .38rem 0;
}

/* Added by StoryScript to explicit speaker annotations in the story. */
.passage p.dialogue-line,
.passage .spoken-line.dialogue-line {
  margin: .28rem 0;
  padding: .32rem .65rem .35rem .72rem;
  border-left: 2px solid #68747a;
  background: rgba(8, 12, 14, .42);
  color: #e2ded4;
  font-family: Georgia, "Times New Roman", serif;
}

.passage p.dialogue-line::before,
.passage .spoken-line.dialogue-line::before {
  content: "TRANSCRIPT";
  display: block;
  margin-bottom: .05rem;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: .62rem;
  letter-spacing: .16em;
}

.passage p.dialogue-line.speaker-voss,
.passage .spoken-line.dialogue-line.speaker-voss {
  border-left-color: var(--voss);
  color: #c8d9df;
}

.passage p.dialogue-line.speaker-voss::before,
.passage .spoken-line.dialogue-line.speaker-voss::before {
  content: "VOSS";
  color: var(--voss);
}

.passage p.dialogue-line.speaker-alex,
.passage .spoken-line.dialogue-line.speaker-alex {
  border-left-color: var(--alex);
  color: #e4d1b7;
}

.passage p.dialogue-line.speaker-alex::before,
.passage .spoken-line.dialogue-line.speaker-alex::before {
  content: "ALEX";
  color: var(--alex);
}

.spoken-line { display: block; }

/* Mixed narration/speech keeps its line compact without turning the whole
   paragraph into a transcript card. */
.passage .spoken-line.dialogue-line {
  margin: .3rem 0;
  padding: .3rem .62rem .32rem .7rem;
}

.passage .spoken-line.dialogue-line::before { margin-bottom: .05rem; }

/* An action that introduces a line should read as one beat, not as two
   separated paragraphs.  The selector is applied after speaker lines have
   been classified by StoryScript. */
.passage > p:not(.dialogue-line):has(+ p.dialogue-line) {
  margin-bottom: .18rem;
}

.passage > p.dialogue-line + p:not(.dialogue-line) {
  margin-top: .22rem;
}

.passage p.dialogue-line.speaker-rowan,
.passage .spoken-line.dialogue-line.speaker-rowan {
  border-left-color: #a69a86;
  color: #d0c7b8;
}

.passage p.dialogue-line.speaker-rowan::before,
.passage .spoken-line.dialogue-line.speaker-rowan::before {
  content: "ROWAN";
  color: #a69a86;
}

.passage p.inner-thought {
  margin: .34rem 0 .34rem .55rem;
  padding: .12rem 0 .12rem .72rem;
  border-left: 1px solid #49545a;
  color: #aeb5b6;
  font-style: italic;
}

.passage .thought-line.inner-thought {
  display: block;
  margin: .32rem 0;
  padding: .1rem 0 .1rem .65rem;
  border-left: 1px solid #49545a;
  color: #aeb5b6;
  font-style: italic;
}

.passage .message-line {
  display: block;
  margin: .32rem 0;
  padding-left: .65rem;
  border-left: 1px dashed #596268;
  color: #aeb5b6;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: .88em;
}

.passage p.inner-thought::before,
.passage .thought-line.inner-thought::before {
  content: "THOUGHT";
  display: block;
  margin-bottom: .06rem;
  color: #858d90;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: .58rem;
  font-style: normal;
  letter-spacing: .14em;
}

.passage > p:first-child:first-letter {
  color: #e8e4d9;
}

.passage em {
  color: #adb5b8;
}

.passage strong {
  color: var(--ink);
  letter-spacing: .02em;
}

.passage a.link-internal {
  display: block;
  margin: .48rem 0;
  min-height: 44px;
  box-sizing: border-box;
  padding: .65rem .9rem;
  border: 1px solid #59656c;
  background: #161e23;
  color: var(--ink);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: .84rem;
  line-height: 1.45;
  text-decoration: none;
  transition: border-color 150ms ease, background 150ms ease, color 150ms ease;
}

.passage a.link-internal::before {
  content: "[  ] ";
  color: var(--muted);
}

.passage a.link-internal:hover,
.passage a.link-internal:focus-visible {
  border-color: var(--ink);
  background: var(--steel-light);
  color: #fff;
  outline: 2px solid transparent;
}

.passage a.link-internal:hover::before,
.passage a.link-internal:focus-visible::before {
  content: "[OK] ";
  color: var(--warning);
}

.passage a.link-internal.alex-choice {
  border-left: 2px solid var(--alex);
  color: #e4d1b7;
}

.passage .evidence,
.passage .usb,
.passage .headlight {
  display: inline-block;
  padding: .05rem .35rem;
  border: 1px solid var(--line);
  color: #d2d7d5;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: .88em;
  letter-spacing: .02em;
}

.passage .evidence { background: #172026; }
.passage .usb { border-style: dashed; background: #141c20; }
.passage .headlight { color: #c8b7a2; background: #211f1c; }

@keyframes passage-in {
  from { opacity: 0; transform: translateY(3px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 540px) {
  body { font-size: 1rem; }
  #ui-bar { padding: .65rem 1rem; }
  .case-status { align-items: flex-start; flex-direction: column; gap: .35rem; }
  #story { width: calc(100% - 1rem); margin: 1rem auto 2rem; padding: 1.5rem 1rem 2rem; }
  .passage a.link-internal { padding: .85rem .8rem; }
}

@media (prefers-reduced-motion: reduce) {
  .passage { animation: none; }
  .passage a.link-internal, #story { transition: none; }
}

:: StoryScript [script]
/* Keep the persistent status UI in sync with SugarCube state and use explicit
   source annotations for speakers, rather than trying to infer a speaker from
   the wording of a line.  The procedural score is intentionally generated in
   browser: no external or copyrighted audio assets are loaded. */
(function () {
  var score = { context: null, master: null, nodes: [], timer: null, enabled: false };
  var endings = [
    'The Perfect Lie', 'Perfect Lie:',
    'False Witness', 'False Witness:',
    'The Driver', 'The Driver:',
    'Caught in the Lie', 'Caught in the Lie:'
  ];

  function suspicion() {
    var value = Number(SugarCube.State.variables.suspicion);
    return Math.max(0, Math.min(5, Number.isFinite(value) ? value : 0));
  }

  function mode() {
    var title = SugarCube.State.passage || '';
    if (title.indexOf('Flashback') === 0) return 'flashback';
    if (endings.some(function (ending) {
      return title.startsWith(ending);
    })) return 'ending';
    return suspicion() >= 4 ? 'critical' : suspicion() >= 2 ? 'tense' : 'low';
  }

  function stopScore() {
    if (score.timer) window.clearInterval(score.timer);
    score.timer = null;
    score.nodes.forEach(function (node) {
      try { node.stop(); } catch (ignore) {}
      try { node.disconnect(); } catch (ignore) {}
    });
    score.nodes = [];
  }

  function oscillator(frequency, type, volume) {
    var oscillatorNode = score.context.createOscillator();
    var gain = score.context.createGain();
    oscillatorNode.type = type;
    oscillatorNode.frequency.value = frequency;
    gain.gain.value = volume;
    oscillatorNode.connect(gain).connect(score.master);
    oscillatorNode.start();
    score.nodes.push(oscillatorNode, gain);
    return { oscillator: oscillatorNode, gain: gain };
  }

  function accent(frequency, duration, volume) {
    if (!score.context) return;
    var now = score.context.currentTime;
    var tone = score.context.createOscillator();
    var gain = score.context.createGain();
    tone.type = 'triangle';
    tone.frequency.setValueAtTime(frequency, now);
    gain.gain.setValueAtTime(0.0001, now);
    gain.gain.exponentialRampToValueAtTime(volume, now + .018);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
    tone.connect(gain).connect(score.master);
    tone.start(now);
    tone.stop(now + duration + .03);
  }

  function buildScore() {
    stopScore();
    if (!score.enabled || !score.context || score.context.state !== 'running') return;
    var current = mode();
    score.master.gain.setTargetAtTime(.32, score.context.currentTime, .08);
    if (current === 'flashback') {
      oscillator(48, 'sine', .035);
      oscillator(151, 'sine', .009).oscillator.detune.value = -9;
      oscillator(157, 'sine', .008).oscillator.detune.value = 11;
      score.timer = window.setInterval(function () { accent(295, .22, .016); }, 1250);
    } else if (current === 'ending') {
      oscillator(55, 'sine', .035);
      oscillator(82.4, 'sine', .014);
      score.timer = window.setInterval(function () { accent(110, .55, .022); }, 1850);
    } else {
      var level = current === 'critical' ? 2 : current === 'tense' ? 1 : 0;
      oscillator(level === 2 ? 46 : 52, 'sine', .04);
      oscillator(level === 0 ? 78 : 98, 'triangle', level === 2 ? .018 : .012);
      if (level > 0) oscillator(level === 2 ? 146 : 122, 'sine', level === 2 ? .012 : .007);
      score.timer = window.setInterval(function () {
        accent(level === 2 ? 82 : 72, level === 2 ? .11 : .16, level === 2 ? .032 : .02);
      }, level === 2 ? 470 : level === 1 ? 780 : 1320);
    }
  }

  function toggleScore() {
    var Button = document.getElementById('sound-toggle');
    if (!score.context) {
      var AudioContext = window.AudioContext || window.webkitAudioContext;
      if (!AudioContext) {
        if (Button) Button.textContent = 'Music unavailable';
        return;
      }
      score.context = new AudioContext();
      score.master = score.context.createGain();
      score.master.gain.value = .0001;
      score.master.connect(score.context.destination);
    }
    score.enabled = !score.enabled;
    if (score.enabled) {
      score.context.resume().then(buildScore);
    } else {
      stopScore();
    }
    if (Button) {
      Button.textContent = score.enabled ? 'Music: On' : 'Music: Off';
      Button.setAttribute('aria-pressed', String(score.enabled));
    }
  }

  function updateStatus() {
    var value = suspicion();
    var meter = document.querySelector('#story-caption .suspicion-meter');
    if (meter) {
      meter.setAttribute('aria-label', 'Suspicion: ' + value + ' out of 5');
      meter.querySelectorAll('.suspicion-block').forEach(function (block, index) {
        block.classList.toggle('is-active', index < value);
      });
    }
    document.body.classList.toggle('suspicion-elevated', value >= 2);
    document.body.classList.toggle('suspicion-critical', value >= 4);
    document.body.classList.toggle('flashback-mode', mode() === 'flashback');
    document.body.classList.toggle('ending-mode', mode() === 'ending');
    if (score.enabled) buildScore();
  }

  function classifyPassage() {
    var passage = document.querySelector('#passages .passage');
    if (!passage) return;

    /* Two or more source breaks represent one paragraph boundary.  Replace
       the stack so macro/include whitespace cannot create visual voids. */
    var breaks = [];
    function collapseBreaks() {
      if (breaks.length > 1) {
        var beat = document.createElement('span');
        beat.className = 'story-beat';
        breaks[0].replaceWith(beat);
        breaks.slice(1).forEach(function (lineBreak) { lineBreak.remove(); });
      } else if (breaks.length === 1) {
        breaks[0].remove();
      }
      breaks = [];
    }

    Array.from(passage.childNodes).forEach(function (node) {
      if (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'BR') {
        breaks.push(node);
      } else if (node.nodeType !== Node.TEXT_NODE || node.textContent.trim()) {
        collapseBreaks();
      }
    });
    collapseBreaks();

    passage.querySelectorAll('[data-speaker]').forEach(function (line) {
      var paragraph = line.closest('p');
      var isOnlyContent = paragraph && paragraph.textContent.trim() === line.textContent.trim();
      var container = isOnlyContent && paragraph.querySelectorAll('[data-speaker]').length === 1
        ? paragraph
        : line;
      line.classList.remove('dialogue-line', 'speaker-voss', 'speaker-alex', 'speaker-rowan');
      if (container !== line) line.classList.remove('spoken-line');
      container.classList.add('dialogue-line', 'speaker-' + line.getAttribute('data-speaker'));
      if (container === line) container.classList.add('spoken-line');
    });

    passage.querySelectorAll('p').forEach(function (paragraph) {
      var text = paragraph.textContent.trim();
      if (!paragraph.querySelector('.thought-line') && !paragraph.querySelector('[data-speaker]') && /^[“\"]/.test(text)) {
        paragraph.classList.add('dialogue-line');
      }
    });

    passage.querySelectorAll('.thought-line').forEach(function (thought) {
      thought.classList.add('inner-thought');
    });

    passage.querySelectorAll('a.link-internal').forEach(function (choice) {
      if (/^[“\"]/.test(choice.textContent.trim())) choice.classList.add('alex-choice');
    });
  }

  $(document).on(':passageend.caseUi', function () {
    classifyPassage();
    updateStatus();
  });
  $(document).on('click.caseUi', '#sound-toggle', toggleScore);
  $(document).on(':storyready.caseUi', updateStatus);
  window.addEventListener('pagehide', stopScore);
}());

